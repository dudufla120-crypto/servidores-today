# ============================================================
# Way Servidores - backend + worker (imagem única, comando troca)
# Build: docker build -f docker/Dockerfile.backend -t way-backend .
# Usa Java 21 para rodar os servidores Minecraft + node-pty (console).
# ============================================================
FROM node:22-alpine AS build

WORKDIR /app

RUN apk add --no-cache python3 make g++ linux-headers

COPY package.json package-lock.json tsconfig.base.json ./
COPY backend/package.json backend/
COPY server-manager/package.json server-manager/
COPY plugin-manager/package.json plugin-manager/
COPY mod-manager/package.json mod-manager/
COPY file-manager/package.json file-manager/
COPY workers/package.json workers/
COPY frontend/package.json frontend/

RUN npm ci

COPY . .

RUN npm run build -w backend && npm prune --omit=dev

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

# Java 21 (JRE) para iniciar os servidores Minecraft
RUN apk add --no-cache openjdk21-jre-headless bash

COPY --from=build /app/package.json /app/tsconfig.base.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/api ./api
COPY --from=build /app/database ./database
COPY --from=build /app/backend ./backend
COPY --from=build /app/server-manager ./server-manager
COPY --from=build /app/plugin-manager ./plugin-manager
COPY --from=build /app/mod-manager ./mod-manager
COPY --from=build /app/file-manager ./file-manager
COPY --from=build /app/workers ./workers

RUN mkdir -p /app/data/servidores

EXPOSE 4000

CMD ["node", "backend/dist/backend/src/index.js"]