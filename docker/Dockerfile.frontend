# ============================================================
# Way Servidores - frontend (build estático servido pelo nginx)
# ============================================================
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json tsconfig.base.json ./
COPY backend/package.json backend/
COPY server-manager/package.json server-manager/
COPY plugin-manager/package.json plugin-manager/
COPY mod-manager/package.json mod-manager/
COPY file-manager/package.json file-manager/
COPY workers/package.json workers/
COPY frontend/package.json frontend/

RUN npm install

COPY . .
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

RUN npm run build -w frontend && cp -r frontend/dist /app/dist

FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]