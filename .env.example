# =============================================================================
# WAY SERVIDORES - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o arquivo ".env" no GitHub. Use GitHub Secrets em produção.
# =============================================================================

# ---------------------------------------------------------------------------
# GERAL
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# Ex.: postgres://way:senha@localhost:5432/way_servidores
#      postgres://way:senha@db:5432/way_servidores (via docker-compose)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://way:senha-segura@localhost:5432/way_servidores
# Senha do banco usada pelo docker-compose (VPS)
POSTGRES_PASSWORD=way-local-password

# ---------------------------------------------------------------------------
# VMs / HOSPEDAGEM DOS SERVIDORES MINECRAFT
# Os arquivos dos usuários (mundos, plugins, mods, logs) ficam NAS VMs,
# nunca no GitHub. Aponte o diretório-raiz onde os servers serão criados.
# ---------------------------------------------------------------------------
SERVERS_DIR=/var/way/servidores
BACKUPS_DIR=/var/way/backups
SERVER_DEFAULT_MEMORY_MB=2048
SERVER_DEFAULT_PORT_RANGE=25565-25665

# ---------------------------------------------------------------------------
# APIs EXTERNAS (fontes oficiais de versões - atualizadas automaticamente)
# ---------------------------------------------------------------------------
MC_MANIFEST_URL=https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
PAPER_API_URL=https://fill.papermc.io/v3/projects/paper
PURPUR_API_URL=https://api.purpurmc.org/v2/purpur
FABRIC_META_URL=https://meta.fabricmc.net/v2
FORGE_PROMO_URL=https://files.minecraftforge.net/net/minecraftforge/forge/promotions_slim.json
NEOFORGE_MAVEN_URL=https://maven.neoforged.net/releases/net/neoforged/neoforge/maven-metadata.xml
SPIGOT_FALLBACK_DOWNLOAD=https://download.spigotmc.org/spigot

# ---------------------------------------------------------------------------
# WORKERS (atualização automática da biblioteca de versões)
# ---------------------------------------------------------------------------
UPDATE_INTERVAL_MS=21600000
VERSIONS_CACHE_FILE=database/cache/versions.json
VERSIONS_CACHE_MAX_AGE_MS=86400000

# ---------------------------------------------------------------------------
# AUTENTICAÇÃO DA API (chave para o painel acessar a API)
# ---------------------------------------------------------------------------
API_KEY=troque-por-uma-chave-aleatoria-segura
# Somente para desenvolvimento local (permite o painel sem chave).
# Em produção, deixe vazio ou "false".
API_PUBLIC_MODE=true

# ---------------------------------------------------------------------------
# SESSÃO / JWT (futuro login)
# ---------------------------------------------------------------------------
JWT_SECRET=troque-por-outra-chave-aleatoria-segura

# ---------------------------------------------------------------------------
# PLUGINS E MODS
# ---------------------------------------------------------------------------
# Opcional: necessária apenas se quiser buscar no CurseForge.
CURSEFORGE_API_KEY=

# ---------------------------------------------------------------------------
# FILE MANAGER (acesso aos arquivos dos servidores)
# Se o painel roda na MESMA VM dos servidores, deixe FILE_SSH_HOST vazio
# e o sistema acessa os arquivos diretamente no disco local.
# Se o painel roda separado, preencha com as credenciais SSH da VM.
# ---------------------------------------------------------------------------
FILE_SSH_HOST=
FILE_SSH_PORT=22
FILE_SSH_USER=way
FILE_SSH_PRIVATE_KEY=/home/way/.ssh/id_ed25519
FILE_SSH_PASSPHRASE=

# ---------------------------------------------------------------------------
# DOMÍNIOS (mapeamento painel -> servidores)
# ---------------------------------------------------------------------------
PANEL_DOMAIN=painel.seudominio.com
# Wildcard exemplo: *.servers.seudominio.com
SERVER_WILDCARD_DOMAIN=servers.seudominio.com

# ---------------------------------------------------------------------------
# GOOGLE ADSENSE (anúncios no painel)
# ---------------------------------------------------------------------------
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# ---------------------------------------------------------------------------
# DEPLOY (Render / Railway / VPS)
# ---------------------------------------------------------------------------
# URL pública do frontend após o deploy
FRONTEND_URL=http://localhost:5173